class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
        int n = grid.length;
        int[] freq = new int[n * n + 1];

        int number = 0;
        for(int i = 0; i < grid.length; i++){
            for(int j = 0; j < grid[0].length; j++){
                number = grid[i][j];
                freq[number]++;
            }
        }
        int repeated = 0;
        int missing = 0;
        
        for(int i = 1; i <= n * n; i++){
            if(freq[i] == 2){
                repeated = i;
            }
            else if(freq[i] == 0){
                missing = i;
            }
        }
        return new int[]{repeated, missing};
    }
}
