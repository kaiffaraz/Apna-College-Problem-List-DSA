class Solution {
    public int maxSubArray(int[] nums) {
        int Csum = 0;
        int maxSum = nums[0];
        for(int i = 0; i < nums.length; i++){
            Csum = Csum + nums[i];

            if(Csum > maxSum){
                maxSum = Csum;
            }

            if(Csum < 0){
                Csum = 0;
            }
        }
        return maxSum;
    }
}
