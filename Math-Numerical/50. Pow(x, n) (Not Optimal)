class Solution {
    public double myPow(double x, int n) {
        double ans = 1;
        if(x == -1 && n <= Integer.MIN_VALUE){
            return ans = x * -1;
        }
        else if(x == 1 || n == 1){
            return x;
        }
        else if(x == 0){
            return 0;
        }
        else if(n <= Integer.MIN_VALUE){
            return 0;
        }
        else if(n >= Integer.MAX_VALUE){
            return x;
        }
        else if(n > 0){
            for(int i = 0; i < n; i++){
                ans = ans * x;
            }
        }
        else if(n < 0){
            n = n * -1;
            for(int i = 0; i < n; i++){
                ans = ans * x;
            }
            ans = 1 / ans;
        }
        return ans;
    }
}
